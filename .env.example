# Copie ce fichier en .env et remplis les valeurs

# Clé secrète Flask (change-la !)
SECRET_KEY=change-moi-en-production

# Twilio (pour l'envoi de SMS)
# Crée un compte sur https://www.twilio.com (essai gratuit disponible)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# Ton numéro de téléphone (pour recevoir une copie des SMS envoyés, optionnel)
MON_NUMERO=+33xxxxxxxxx
