# ── Copie ce fichier en .env et remplis les valeurs ──────────────────────────

# Clé secrète Flask (génère une chaîne aléatoire longue)
SECRET_KEY=change-moi-en-production-mettre-une-longue-chaine-aleatoire

# Mot de passe d'accès à l'application
APP_PASSWORD=orange2026

# Twilio — pour l'envoi de SMS automatiques
# Crée un compte sur https://www.twilio.com (essai gratuit ~15€ offerts)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# Anthropic — pour le scan automatique des bons de commande + entraîneur IA
# Obtenir une clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs — voix humaine pour l'entraîneur IA (optionnel, fallback navigateur sinon)
# Obtenir une clé sur https://elevenlabs.io (plan gratuit disponible)
ELEVENLABS_API_KEY=
# IDs de voix (modifiables selon ton compte ElevenLabs)
# Charlotte — voix féminine française (prospect)
# Adam      — voix masculine profonde (coach)
ELEVENLABS_VOICE_CLIENT=XB0fDUnXU5powFXDhCwa
ELEVENLABS_VOICE_COACH=pNInz6obpgDQGcFmaJgB
