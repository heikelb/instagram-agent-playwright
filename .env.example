# ── Copie ce fichier en .env et remplis les valeurs ──────────────────────────

# Clé secrète Flask (génère une chaîne aléatoire longue)
SECRET_KEY=change-moi-en-production-mettre-une-longue-chaine-aleatoire

# Mot de passe d'accès à l'application
APP_PASSWORD=orange2026

# Twilio — pour l'envoi de SMS automatiques
# Crée un compte sur https://www.twilio.com (essai gratuit ~15€ offerts)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+33xxxxxxxxx

# Anthropic — pour le scan automatique des bons de commande (Claude Vision)
# Obtenir une clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ton propre numéro de téléphone — pour recevoir les rappels clients par SMS à 12h30 et 19h
# Si non renseigné, les rappels sont visibles dans l'app uniquement (pas de SMS)
MON_TELEPHONE=+33612345678

# Identifiants Orange — pour le suivi automatique des commandes via le CRM
# L'app se connecte avec ces identifiants pour lire le statut de tes commandes
ORANGE_LOGIN=ton.email@orange.fr
ORANGE_PASSWORD=ton_mot_de_passe_orange
